<Window x:Class="SimpleXmlEditor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="设置 - XML AI 翻译器" Height="650" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" 
        MinHeight="600" MinWidth="650"
        Background="#F0EEF6" Loaded="Window_Loaded">
    
    <Window.Resources>
    </Window.Resources>

    <Border Background="#F7F6FB" CornerRadius="12" Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="#CFD8DC" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.3"/>
        </Border.Effect>
        
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="⚙️" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Name="SettingsTitleLabel" Text="设置" FontSize="20" FontWeight="Bold" Foreground="#1976D2"/>
                    <TextBlock Name="SettingsSubtitleLabel" Text="配置 AI 翻译和专家配置" FontSize="12" Foreground="#666" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Tab Control -->
            <TabControl Grid.Row="1" Margin="0,0,0,12">
                <TabItem Name="GeneralSettingsTab" Header="  🔧  常规设置  ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8">
                        <StackPanel>
                            <!-- AI Provider Selection -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Name="AiProviderHeader" Text="🔌 AI 提供商" FontSize="14" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,8"/>
                                <hc:ComboBox Name="AiProviderComboBox" FontSize="14"
                                          SelectionChanged="AiProviderComboBox_SelectionChanged">
                                    <ComboBoxItem Content="🌐 Google Gemini" Tag="GoogleGemini"/>
                                    <ComboBoxItem Content="🐋 DeepSeek (深度求索)" Tag="DeepSeek"/>
                                    <ComboBoxItem Content="🔴 豆包 (火山引擎)" Tag="Doubao"/>
                                    <ComboBoxItem Content="🟢 千问 (阿里云)" Tag="Qianwen"/>
                                    <ComboBoxItem Content="🟣 智谱 AI (Zhipu)" Tag="Zhipu"/>
                                    <ComboBoxItem Content="🟠 Kimi (月之暗面)" Tag="Moonshot"/>
                                    <ComboBoxItem Content="🔵 文心一言 (百度)" Tag="Wenxin"/>
                                    <ComboBoxItem Content="⚪ 讯飞星火 (Xunfei)" Tag="Xunfei"/>
                                </hc:ComboBox>
                                <TextBlock Name="SelectAiProviderText" Text="选择 AI 翻译服务提供商" FontSize="11" Foreground="#666" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- API Key Section -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Name="ApiKeyHeader" Text="🔑 API 密钥" FontSize="14" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,8"/>
                                <hc:TextBox Name="ApiKeyTextBox" 
                                            hc:InfoElement.Placeholder="输入你的 API 密钥" hc:InfoElement.ShowClearButton="True"
                                            MaxLength="100"/>
                                <TextBlock Name="EnterYourApiKeyText" Text="输入你的 API 密钥" 
                                          FontSize="11" Foreground="#666" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Model Selection Section -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Name="AiModelHeader" Text="🤖 AI 模型" FontSize="14" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <hc:ComboBox Grid.Column="0" Name="ModelComboBox" 
                                             FontSize="14" Margin="0,0,12,0"/>
                                    <Button Grid.Column="1" Name="RefreshModelsBtn" 
                                           Content="🔄 刷新" Click="RefreshModelsBtn_Click" 
                                           Style="{StaticResource PrimaryBtn}" 
                                           Background="#FF9800" Width="100"/>
                                </Grid>
                                <TextBlock Name="AiModelHelpText" Text="选择一个 AI 模型（含速率限制和价格信息）" 
                                          FontSize="11" Foreground="#666" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Target Language Section -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Name="TargetLangHeader" Text="🌍 目标语言" FontSize="14" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,8"/>
                                <hc:ComboBox Name="TargetLanguageComboBox" FontSize="14"/>
                                <TextBlock Name="TargetLangHelpText" Text="选择翻译目标语言" 
                                          FontSize="11" Foreground="#666" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Program Language Section -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Name="ProgramLangHeader" Text="🌐 界面语言" FontSize="14" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,8"/>
                                <hc:ComboBox Name="ProgramLanguageComboBox" FontSize="14">
                                    <ComboBoxItem Content="🇺🇸 English" Tag="en"/>
                                    <ComboBoxItem Content="🇨🇳 中文" Tag="zh"/>
                                </hc:ComboBox>
                                <TextBlock Name="ProgramLangHelpText" Text="选择程序界面语言" 
                                          FontSize="11" Foreground="#666" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Custom Prompt Section -->
                            <StackPanel Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Name="CustomPromptHeader" Text="📝 自定义提示词" FontSize="14" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,8"/>
                                    <Button Grid.Column="1" Name="ResetPromptBtn" Content="🔄 重置" 
                                           Click="ResetPromptBtn_Click" 
                                           Style="{StaticResource PrimaryBtn}" 
                                           Background="#9E9E9E" 
                                           FontSize="10" Height="24" Padding="8,2"/>
                                </Grid>
                                <hc:TextBox Name="CustomPromptTextBox" 
                                        Height="100" 
                                        TextWrapping="Wrap" 
                                        AcceptsReturn="True" 
                                        VerticalScrollBarVisibility="Auto"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        hc:InfoElement.Placeholder="自定义提示词…"/>
                                <TextBlock Name="CustomPromptHelpContent" TextWrapping="Wrap" FontSize="11" Foreground="#666" Margin="0,4,0,0">
                                    自定义 AI 翻译提示词。使用 {LANGUAGE} 表示目标语言，{CONTEXT} 表示内容类型，{TEXTS} 表示待翻译数据。{EXPERT_CONTEXT} 会在翻译时自动替换为当前专家配置的知识。{GLOSSARY} 会自动注入当前批次相关的对照表术语。{MIXED_SOURCE_NOTE} 当批次中包含已有中文翻译时会自动插入修正指令。
                                </TextBlock>
                            </StackPanel>

                            <!-- Info Panel -->
                            <Border Background="#E8F5E8" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Name="QuickTipsTitle" Text="💡 快速提示" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,8"/>
                                    <TextBlock Name="QuickTipsContent" TextWrapping="Wrap" FontSize="12" Foreground="#2E7D32">
                                        • 从 https://aistudio.google.com 免费获取 API 密钥<LineBreak/>
                                        • Flash 模型更快，Pro 模型更准确<LineBreak/>
                                        • 速率限制会根据模型自动优化<LineBreak/>
                                        • 翻译缓存可降低 API 费用<LineBreak/>
                                        • 支持 60+ 种语言翻译<LineBreak/>
                                        • 专家配置可增强特定领域的翻译质量
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Name="ExpertProfilesTab" Header="  🧠  专家配置  ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8">
                        <StackPanel>
                            <!-- Description -->
                            <Border Background="#E3F2FD" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Name="ExpertSystemTitle" Text="🧠 专家配置系统" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,4"/>
                                    <TextBlock Name="ExpertSystemDesc" TextWrapping="Wrap" FontSize="12" Foreground="#1565C0">
                                        专家配置让你可以为 AI 翻译器定义特定领域的知识。
                                        每个配置包含思考指令和术语对照表。
                                        激活后，这些知识会自动注入每次翻译请求，
                                        确保专有名词和领域术语的翻译准确性。
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Action Buttons -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Name="SavedProfilesLabel" Text="📋 已保存的配置" FontSize="14" FontWeight="Bold" 
                                          Foreground="#424242" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Name="AddProfileBtn" Content="➕ 新建配置" Click="AddProfileBtn_Click"
                                       Style="{StaticResource SuccessBtn}" FontSize="12"/>
                            </Grid>

                            <!-- Profiles List -->
                            <ListBox Name="ProfilesListBox" MinHeight="180" MaxHeight="240"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                    Background="#F7F6FB" Margin="0,0,0,12"
                                    SelectionChanged="ProfilesListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#212121"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#757575" 
                                                              TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="✏️" Click="EditProfileBtn_Click" 
                                                           Style="{StaticResource PrimaryBtn}"
                                                           Background="#FF9800" Width="34" Height="30" 
                                                           Padding="0" FontSize="13" Margin="2"/>
                                                    <Button Content="🗑️" Click="DeleteProfileBtn_Click" 
                                                           Style="{StaticResource DangerBtn}"
                                                           Width="34" Height="30" 
                                                           Padding="0" FontSize="13" Margin="2"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Profile Editor Panel -->
                            <Border Name="ProfileEditorPanel" Background="#F0EEF6" CornerRadius="8" 
                                   BorderBrush="#DDD9EA" BorderThickness="1" Padding="16"
                                   Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Name="ProfileEditorTitle" Text="编辑配置" 
                                              FontSize="14" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,12"/>

                                    <!-- Name -->
                                    <TextBlock Name="ProfileNameHeader" Text="配置名称" FontSize="12" FontWeight="Bold" Foreground="#616161" Margin="0,0,0,4"/>
                                    <hc:TextBox Name="ProfileNameTxt" FontSize="13"
                                            Margin="0,0,0,12" hc:InfoElement.Placeholder="配置名称" hc:InfoElement.ShowClearButton="True"/>

                                    <!-- Description -->
                                    <TextBlock Name="ProfileDescHeader" Text="描述" FontSize="12" FontWeight="Bold" Foreground="#616161" Margin="0,0,0,4"/>
                                    <hc:TextBox Name="ProfileDescTxt" FontSize="13"
                                            Margin="0,0,0,12" hc:InfoElement.Placeholder="描述" hc:InfoElement.ShowClearButton="True"/>

                                    <!-- Context / Thinking Instructions -->
                                    <TextBlock Name="ProfileContextHeader" Text="上下文 &amp; 思考指令" FontSize="12" FontWeight="Bold" 
                                              Foreground="#616161" Margin="0,0,0,4"/>
                                    <TextBlock Name="ProfileContextHelp" Text="告诉 AI 如何理解这个领域。可以用 {LANGUAGE} 指代目标语言。" 
                                              FontSize="10" Foreground="#999" Margin="0,0,0,4"/>
                                    <hc:TextBox Name="ProfileContextTxt" FontSize="12"
                                            Height="80" TextWrapping="Wrap" AcceptsReturn="True" 
                                            VerticalScrollBarVisibility="Auto"
                                            FontFamily="Consolas" Margin="0,0,0,12"
                                            hc:InfoElement.Placeholder="告诉 AI 如何理解这个领域…"/>

                                    <!-- Glossary -->
                                    <TextBlock Name="ProfileGlossaryHeader" Text="术语对照表" FontSize="12" FontWeight="Bold" 
                                              Foreground="#616161" Margin="0,0,0,4"/>
                                    <TextBlock Name="ProfileGlossaryHelp" Text="每行一条。格式：英文术语 = 目标翻译（例如：Jedi = 绝地）" 
                                              FontSize="10" Foreground="#999" Margin="0,0,0,4"/>
                                    <hc:TextBox Name="ProfileGlossaryTxt" FontSize="12"
                                            Height="100" TextWrapping="Wrap" AcceptsReturn="True" 
                                            VerticalScrollBarVisibility="Auto"
                                            FontFamily="Consolas" Margin="0,0,0,12"
                                            hc:InfoElement.Placeholder="Jedi = 绝地"/>

                                    <!-- Save/Cancel -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Name="CancelProfileBtn" Content="取消" Click="CancelProfileBtn_Click" 
                                               Style="{StaticResource GreyBtn}" Width="80"/>
                                        <Button Name="SaveProfileBtn" Content="💾 保存" Click="SaveProfileBtn_Click" 
                                               Style="{StaticResource SuccessBtn}" Width="80"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Name="EvaluationModelTab" Header="  🔍  评估模型  ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8">
                        <StackPanel>
                            <Border Background="#FFF3E0" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock x:Name="EvalModelConfigTitle" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="EvalModelConfigDesc" TextWrapping="Wrap" FontSize="12" Foreground="#E65100"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock x:Name="EvalProviderHeader" FontSize="14" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,8"/>
                                <hc:ComboBox x:Name="EvalProviderComboBox" FontSize="14">
                                    <ComboBoxItem x:Name="EvalUseTranslationModelItem" Tag=""/>
                                    <ComboBoxItem Content="🌐 Google Gemini" Tag="GoogleGemini"/>
                                    <ComboBoxItem Content="🐋 DeepSeek" Tag="DeepSeek"/>
                                    <ComboBoxItem Content="🔴 豆包" Tag="Doubao"/>
                                    <ComboBoxItem Content="🟢 千问" Tag="Qianwen"/>
                                    <ComboBoxItem Content="🟣 智谱 AI" Tag="Zhipu"/>
                                    <ComboBoxItem Content="🟠 Kimi" Tag="Moonshot"/>
                                    <ComboBoxItem Content="🔵 文心一言" Tag="Wenxin"/>
                                    <ComboBoxItem Content="⚪ 讯飞星火" Tag="Xunfei"/>
                                </hc:ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock x:Name="EvalApiKeyHeader" FontSize="14" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,8"/>
                                <hc:TextBox x:Name="EvalApiKeyTextBox"
                                            hc:InfoElement.ShowClearButton="True"
                                            MaxLength="100"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock x:Name="EvalModelHeader" FontSize="14" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,8"/>
                                <hc:TextBox x:Name="EvalModelTextBox"
                                            hc:InfoElement.ShowClearButton="True"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Name="CancelButton" Content="取消" 
                       Click="CancelButton_Click" 
                       Style="{StaticResource GreyBtn}" 
                       Width="100" Margin="0,0,12,0"/>
                <Button Name="OkButton" Content="保存并应用" 
                       Click="OkButton_Click" 
                       Style="{StaticResource SuccessBtn}" 
                       Width="120"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
