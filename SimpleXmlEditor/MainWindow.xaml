<Window x:Class="SimpleXmlEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XML AI Translator" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen" Background="#F0F2F5">
    
    <Window.Resources>
        <!-- ===== Button Base Template ===== -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}"
                                RenderOptions.BitmapScalingMode="HighQuality">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.76"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Color Variants ===== -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#2196F3"/>
        </Style>
        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#4CAF50"/>
        </Style>
        <Style x:Key="WarningBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#FF9800"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#EF5350"/>
        </Style>
        <Style x:Key="CyanBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#00ACC1"/>
        </Style>
        <Style x:Key="PurpleBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#7E57C2"/>
        </Style>
        <Style x:Key="TealBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#00897B"/>
        </Style>
        <Style x:Key="AmberBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#FFA726"/>
        </Style>
        <Style x:Key="GreyBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#78909C"/>
        </Style>
        <Style x:Key="PinkBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#EC407A"/>
        </Style>

        <!-- ===== Ghost Button for header bar ===== -->
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF22"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Modern Card Style ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="BorderBrush" Value="#E8ECF0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ===== Section Title ===== -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- ===== Tag Pill ===== -->
        <Style x:Key="TagPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <!-- ===== Info Label ===== -->
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ TOP HEADER ═══════════ -->
        <Border Grid.Row="0" Background="#1E88E5" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Logo + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🌐" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Name="AppNameText" Text="XML AI Translator" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Name="StatusText" Text="Ready" FontSize="11" Foreground="#B3E5FC"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="LoadBtn" Content="📁 Load XML" Click="LoadBtn_Click" Style="{StaticResource SuccessBtn}"/>
                    <Button Name="SaveBtn" Content="💾 Save" Click="SaveBtn_Click" Style="{StaticResource SuccessBtn}"/>
                    <Button Name="QuickSaveBtn" Content="⚡ Quick Save" Click="QuickSaveBtn_Click" Style="{StaticResource CyanBtn}" ToolTip="Ctrl+S"/>
                    
                    <Separator Style="{x:Null}" Width="8"/>
                    
                    <Button Name="SettingsBtn" Content="⚙️ Settings" Click="SettingsBtn_Click" Style="{StaticResource PurpleBtn}"/>
                    <Button Name="StatsBtn" Content="📊 Stats" Click="StatsBtn_Click" Style="{StaticResource TealBtn}"/>
                    
                    <Separator Style="{x:Null}" Width="8"/>
                    
                    <Button Name="GlossaryBtn" Content="📖 Glossary" Click="GlossaryBtn_Click" Style="{StaticResource PurpleBtn}" ToolTip="Open Glossary Manager"/>
                    <Button Name="BatchReplaceBtn" Content="🔄 Replace" Click="BatchReplaceBtn_Click" Style="{StaticResource AmberBtn}" ToolTip="Batch Replace"/>
                    <Button Name="UndoBtn" Content="↩️ Undo" Click="UndoBtn_Click" Style="{StaticResource PinkBtn}" ToolTip="Undo"/>
                    
                    <Separator Style="{x:Null}" Width="8"/>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox Name="ExpertProfileCombo" Height="30" Width="150" 
                                  SelectionChanged="ExpertProfileCombo_SelectionChanged" 
                                  Margin="4,0" FontSize="12">
                            <ComboBoxItem Name="NoExpertItem" Content="No Expert" Tag="" IsSelected="True"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ AI TRANSLATION PANEL ═══════════ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Background="#E8F5E9" Margin="8,8,8,4" BorderBrush="#C8E6C9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Name="AITranslationTitle" Text="🤖 AI Translation Center" 
                          Style="{StaticResource SectionTitle}" Foreground="#2E7D32" Margin="0,0,0,10"/>
                
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left: Translation Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="TranslateSelectedBtn" Content="🎯 Translate Selected" 
                                Click="TranslateSelectedBtn_Click" Style="{StaticResource PrimaryBtn}"/>
                        
                        <!-- Batch Settings -->
                        <Border Background="White" CornerRadius="6" Padding="10,6" Margin="8,0" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="BatchLabelText" Text="Batch:" Foreground="#78909C" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Name="BatchSizeTxt" Text="50" Width="42" FontSize="13"
                                        BorderBrush="#CFD8DC" BorderThickness="1" Padding="4,3" 
                                        VerticalAlignment="Center" TextChanged="BatchSizeTxt_TextChanged" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <Button Name="TranslateAllBtn" Content="🚀 Translate All" 
                                Click="TranslateAllBtn_Click" Style="{StaticResource WarningBtn}"/>
                        
                        <Button Name="EvaluateBtn" Content="🤖 Evaluate" 
                                Click="EvaluateBtn_Click" Style="{StaticResource TealBtn}" 
                                ToolTip="AI quality evaluation (0-10 score)"/>
                        <Button Name="VoteBtn" Content="🗳 Agent Vote" 
                                Click="VoteBtn_Click" Style="{StaticResource PurpleBtn}" 
                                ToolTip="Multi-agent voting for best translation"/>
                        
                        <Button Name="PauseBtn" Content="⏸ Pause" 
                                Click="PauseBtn_Click" Style="{StaticResource GreyBtn}" 
                                Visibility="Collapsed" Margin="8,0,3,0"/>
                        <Button Name="StopBtn" Content="⏹ Stop" 
                                Click="StopBtn_Click" Style="{StaticResource DangerBtn}" 
                                Visibility="Collapsed"/>
                    </StackPanel>
                    
                    <!-- Right: Cache & Dict Info -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Style="{StaticResource TagPill}" Background="#E8F5E9">
                            <TextBlock Name="EvalResult" Text="" 
                                      Style="{StaticResource InfoLabel}" Foreground="#2E7D32"
                                      ToolTip="Last evaluation result"/>
                        </Border>
                        <Border Style="{StaticResource TagPill}" Background="#E3F2FD">
                            <TextBlock Name="CacheInfo" Text="💾 Cache: 0" 
                                      Style="{StaticResource InfoLabel}" Foreground="#1565C0"/>
                        </Border>
                        <Border Style="{StaticResource TagPill}" Background="#F3E5F5">
                            <TextBlock Name="GlossaryInfo" Text="📖 Glossary: 0" 
                                      Style="{StaticResource InfoLabel}" Foreground="#7B1FA2"/>
                        </Border>
                        <Button Name="ClearCacheBtn" Content="🗑" Click="ClearCacheBtn_Click" 
                                Style="{StaticResource GreyBtn}" Padding="8,6" FontSize="14" ToolTip="Clear Cache"/>
                        <Button Name="ClearDictBtn" Content="🗑" Click="ClearDictBtn_Click" 
                                Style="{StaticResource GreyBtn}" Padding="8,6" FontSize="14" ToolTip="Clear Glossary"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════ MAIN CONTENT ═══════════ -->
        <Grid Grid.Row="2" Margin="8,4,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>
            
            <!-- ===== LEFT: DataGrid ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Title Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="TranslationDataTitle" Text="📋 Translation Data" 
                                  Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBlock Grid.Column="1" Name="FilterCountText" Text="0" 
                                  Foreground="#90A4AE" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <!-- Filter Row -->
                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Name="ClearFilterBtn" Content="✕"
                                    Click="ClearFilterBtn_Click" Style="{StaticResource GreyBtn}" 
                                    Padding="4,0" FontSize="14" Margin="2,0" ToolTip="Clear Filters"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Name="FilterKeyBox" Margin="2" Padding="7,5" FontSize="13"
                                BorderBrush="#CFD8DC" BorderThickness="1" 
                                TextChanged="FilterKeyBox_TextChanged" ToolTip="Filter by Key"/>
                        <TextBox Grid.Column="2" Name="FilterBox" Margin="2" Padding="7,5" FontSize="13"
                                BorderBrush="#CFD8DC" BorderThickness="1" 
                                TextChanged="FilterBox_TextChanged" ToolTip="Filter by Original"/>
                        <TextBox Grid.Column="3" Name="FilterTranslationBox" Margin="2" Padding="7,5" FontSize="13"
                                BorderBrush="#CFD8DC" BorderThickness="1" 
                                TextChanged="FilterTranslationBox_TextChanged" ToolTip="Filter by Translation"/>
                    </Grid>

                    <!-- Find Bar (hidden by default) -->
                    <Border Grid.Row="2" Name="FindBarBorder" Background="#FFF9C4" CornerRadius="4" 
                            Padding="8,6" Margin="0,0,0,4" Visibility="Collapsed" BorderBrush="#FFE082" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Name="FindLabelText" Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Name="FindTextBox" BorderBrush="#CFD8DC" BorderThickness="1" Padding="6,4"
                                    TextChanged="FindTextBox_TextChanged" KeyDown="FindTextBox_KeyDown" FontSize="12"/>
                            <Button Grid.Column="2" Name="FindPrevBtn" Content="▲ Prev" Click="FindPrev_Click" 
                                    Style="{StaticResource GreyBtn}" Padding="8,4" FontSize="11"/>
                            <Button Grid.Column="3" Name="FindNextBtn" Content="Next ▼" Click="FindNext_Click" 
                                    Style="{StaticResource GreyBtn}" Padding="8,4" FontSize="11"/>
                            <TextBlock Grid.Column="4" Name="FindCountText" Text="" VerticalAlignment="Center" 
                                      Margin="8,0" FontSize="11" Foreground="#78909C"/>
                            <Button Grid.Column="5" Name="FindCloseBtn" Content="✕" Width="28" 
                                    Click="FindClose_Click" Style="{StaticResource GreyBtn}" 
                                    Padding="0" FontSize="12"/>
                        </Grid>
                    </Border>
                    
                    <!-- DataGrid -->
                    <DataGrid Grid.Row="3" Name="EntriesGrid" 
                             AutoGenerateColumns="False" CanUserAddRows="False"
                             SelectionMode="Extended" GridLinesVisibility="Horizontal"
                             AlternatingRowBackground="#F8FAFB" HeadersVisibility="Column"
                             BorderThickness="0" Loaded="EntriesGrid_Loaded"
                             FontSize="12.5">
                        <DataGrid.ContextMenu>
                            <ContextMenu FontSize="12">
                                <MenuItem Name="CtxCopyKeyMenu" Header="📋 Copy Key" Click="CtxCopyKey_Click"/>
                                <MenuItem Name="CtxCopyOriginalMenu" Header="📋 Copy Original" Click="CtxCopyOriginal_Click"/>
                                <MenuItem Name="CtxCopyTranslationMenu" Header="📋 Copy Translation" Click="CtxCopyTranslation_Click"/>
                                <Separator/>
                                <MenuItem Name="CtxClearTranslationMenu" Header="🗑 Clear Translation" Click="CtxClearTranslation_Click"/>
                                <MenuItem Name="CtxTranslateSelectedMenu" Header="🌐 Translate Selected" Click="CtxTranslateSelected_Click"/>
                                <Separator/>
                                <MenuItem Name="CtxEvaluateMenu" Header="🤖 AI Evaluate" Click="CtxEvaluate_Click"/>
                                <MenuItem Name="CtxVoteMenu" Header="🗳 Agent Vote" Click="CtxVote_Click"/>
                                <Separator/>
                                <MenuItem Name="CtxSelectAllMenu" Header="☑ Select All" Click="CtxSelectAll_Click"/>
                                <MenuItem Name="CtxSelectNoneMenu" Header="☐ Deselect All" Click="CtxSelectNone_Click"/>
                                <MenuItem Name="CtxInvertSelectionMenu" Header="🔄 Invert" Click="CtxInvertSelection_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#ECEFF1"/>
                                <Setter Property="Foreground" Value="#455A64"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="#CFD8DC"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="36" IsReadOnly="True" FontFamily="Consolas" FontSize="11"/>
                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected}" Width="36"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusIcon}" Width="48" IsReadOnly="True" FontSize="12"/>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*" IsReadOnly="True" MinWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Original" Binding="{Binding Value}" Width="1.5*" IsReadOnly="True" MinWidth="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Translation" Width="1.5*" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Translation}" TextWrapping="Wrap" VerticalAlignment="Center" Padding="8,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Translation, UpdateSourceTrigger=PropertyChanged}" 
                                                TextWrapping="Wrap" AcceptsReturn="True"
                                                BorderThickness="0" Padding="8,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            
            <!-- ===== RIGHT: Activity Log ===== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Log Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="ActivityLogTitle" Text="📋 Activity Log" 
                                  Style="{StaticResource SectionTitle}" Margin="0"/>
                        <Button Grid.Column="1" Name="ClearLogBtn" Content="🗑 Clear" 
                               Click="ClearLogBtn_Click"
                               Style="{StaticResource GreyBtn}" Width="80" Padding="8,6" FontSize="11"/>
                    </Grid>
                    
                    <!-- Console -->
                    <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="6" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Name="LogTextBox" TextWrapping="Wrap"
                                    FontFamily="Consolas, 'Cascadia Code', monospace"
                                    FontSize="11.5" IsReadOnly="True" Background="Transparent"
                                    Foreground="#00FF00" BorderThickness="0" Padding="12"
                                    AcceptsReturn="True" VerticalScrollBarVisibility="Disabled"/>
                        </ScrollViewer>
                    </Border>
                    
                    <!-- Log Stats -->
                    <Border Grid.Row="2" Background="#ECEFF1" CornerRadius="4" Padding="8,6" Margin="0,8,0,0">
                        <Grid>
                            <TextBlock Name="RealTimeLabel" Text="🕒 Real-time" FontSize="10" 
                                      Foreground="#78909C" HorizontalAlignment="Left"/>
                            <TextBlock Name="AutoScrollLabel" Text="🔄 Auto-scroll" FontSize="10" 
                                      Foreground="#78909C" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ BOTTOM BAR ═══════════ -->
        <Border Grid.Row="3" Background="White" CornerRadius="4" Padding="10,6" 
                Margin="8,0,8,8" BorderBrush="#E8ECF0" BorderThickness="1">
            <ProgressBar Name="ProgressBar" Height="14" IsIndeterminate="False" Visibility="Collapsed"
                        Foreground="#2196F3" Background="#ECEFF1" BorderThickness="0"/>
        </Border>
    </Grid>
</Window>
