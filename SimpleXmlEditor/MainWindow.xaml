<Window x:Class="SimpleXmlEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimpleXmlEditor"
        Title="" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen" Background="#F0F2F5">

    <Window.Resources>
        <!-- ===== Button Base Template ===== -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                RenderOptions.BitmapScalingMode="HighQuality">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.76"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Color Variants ===== -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#2196F3"/>
        </Style>
        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#4CAF50"/>
        </Style>
        <Style x:Key="WarningBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#FF9800"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#EF5350"/>
        </Style>
        <Style x:Key="CyanBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#00ACC1"/>
        </Style>
        <Style x:Key="PurpleBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#7E57C2"/>
        </Style>
        <Style x:Key="TealBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#00897B"/>
        </Style>
        <Style x:Key="AmberBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#FFA726"/>
        </Style>
        <Style x:Key="GreyBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#78909C"/>
        </Style>
        <Style x:Key="PinkBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#EC407A"/>
        </Style>

        <!-- ===== Ghost Button for header bar ===== -->
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF22"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Modern Card Style ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="BorderBrush" Value="#E8ECF0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ===== Section Title ===== -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- ===== Tag Pill ===== -->
        <Style x:Key="TagPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <!-- ===== Info Label ===== -->
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ MENU BAR ═══════════ -->
        <Menu Grid.Row="0" Background="#37474F" FontSize="14" FontWeight="SemiBold" BorderBrush="#263238" BorderThickness="0,0,0,1">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Padding" Value="14,5"/>
                    <Setter Property="Foreground" Value="#333333"/>
                </Style>
                <Style TargetType="MenuItem" x:Key="TopMenuStyle">
                    <Setter Property="Padding" Value="14,5"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#37474F"/>
                </Style>
            </Menu.Resources>


            <!-- File -->
            <MenuItem Name="MenuFile" Header="📁 File" Style="{StaticResource TopMenuStyle}">
                <MenuItem Name="MenuOpen" Header="📂 Open (Ctrl+O)" Click="LoadBtn_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Name="MenuSave" Header="💾 Save (Ctrl+S)" Click="SaveBtn_Click" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Name="MenuExportReview" Header="📋 Export Review (CSV)" Click="ExportReviewBtn_Click"/>
                <Separator/>
                <MenuItem Name="MenuExit" Header="Exit" Click="MenuExit_Click"/>
            </MenuItem>

            <!-- Edit -->
            <MenuItem Name="MenuEdit" Header="✏️ Edit" Style="{StaticResource TopMenuStyle}">
                <MenuItem Name="MenuUndo" Header="↩️ Undo" Click="UndoBtn_Click"/>
                <MenuItem Name="MenuReplace" Header="🔄 Replace" Click="BatchReplaceBtn_Click"/>
            </MenuItem>

            <!-- View -->
            <MenuItem Name="MenuView" Header="👁 View" Style="{StaticResource TopMenuStyle}">
                <MenuItem Name="MenuDarkMode" Header="🌙 Dark Mode" Click="MenuDarkMode_Click"/>
                <MenuItem Name="MenuShowFilter" Header="🔍 Show Filter" Click="MenuShowFilter_Click"/>
                <MenuItem Name="MenuShowLog" Header="📋 Show Log" Click="MenuShowLog_Click"/>
            </MenuItem>

            <!-- Translate -->
            <MenuItem Name="MenuTranslate" Header="🌐 Translate" Style="{StaticResource TopMenuStyle}">
                <MenuItem Name="MenuTranslateSelected" Header="🎯 Selected" Click="TranslateSelectedBtn_Click"/>
                <MenuItem Name="MenuTranslateAll" Header="🚀 All" Click="TranslateAllBtn_Click"/>
                <MenuItem Name="MenuSmartPreTrans" Header="🔮 Smart Pre-trans" Click="MenuSmartPreTrans_Click"/>
                <MenuItem Name="MenuBatchSize" Header="📦 Batch Size: 50"/>
            </MenuItem>

            <!-- Quality -->
            <MenuItem Name="MenuQuality" Header="⭐ Quality" Style="{StaticResource TopMenuStyle}">
                <MenuItem Name="MenuEvaluate" Header="🤖 AI Evaluate (F5)" Click="EvaluateBtn_Click" InputGestureText="F5"/>
                <MenuItem Name="MenuVote" Header="🗳 Agent Vote (F6)" Click="VoteBtn_Click" InputGestureText="F6"/>
                <MenuItem Name="MenuConsistency" Header="🔍 Consistency" Click="MenuConsistency_Click"/>
            </MenuItem>

            <!-- Tools -->
            <MenuItem Name="MenuTools" Header="🔧 Tools" Style="{StaticResource TopMenuStyle}">
                <MenuItem Name="MenuGlossary" Header="📖 Glossary" Click="GlossaryBtn_Click"/>
                <MenuItem Name="MenuStatistics" Header="📊 Statistics" Click="StatsBtn_Click"/>
                <MenuItem Name="MenuSettings" Header="⚙️ Settings" Click="SettingsBtn_Click"/>
                <Separator/>
                <MenuItem Name="MenuClearDict" Header="🗑️ Clear Glossary" Click="ClearDictBtn_Click"/>
            </MenuItem>

            <!-- Help -->
            <MenuItem Name="MenuHelp" Header="❓ Help" Style="{StaticResource TopMenuStyle}">
                <MenuItem Name="MenuShortcuts" Header="⌨ Shortcuts" Click="MenuShortcuts_Click"/>
                <MenuItem Name="MenuAbout" Header="ℹ️ About" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- ═══════════ SIMPLIFIED HEADER TOOLBAR ═══════════ -->
        <Border Grid.Row="1" Background="#1E88E5" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🌐" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Name="AppNameText" Text="XML AI Translator" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Name="StatusText" Text="Ready" FontSize="11" Foreground="#B3E5FC"/>
                    </StackPanel>
                </StackPanel>

                <!-- Primary Action Buttons (simplified) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="LoadBtn" Content="📁 Load XML" Click="LoadBtn_Click" Style="{StaticResource PrimaryBtn}"/>
                    <Button Name="SaveBtn" Content="💾 Save" Click="SaveBtn_Click" Style="{StaticResource SuccessBtn}"/>

                    <Separator Style="{x:Null}" Width="10"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox Name="ExpertProfileCombo" Height="30" Width="150"
                                  SelectionChanged="ExpertProfileCombo_SelectionChanged"
                                  Margin="4,0" FontSize="12">
                            <ComboBoxItem Name="NoExpertItem" Content="No Expert" Tag="" IsSelected="True"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ FILE TABS PANEL ═══════════ -->
        <Border Grid.Row="2" Name="FileTabsPanel" Background="#F5F5F5" Padding="8,4"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Visibility="Visible">
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="ProjectFiles" Text="📄 Project" FontSize="13" FontWeight="SemiBold"
                           Foreground="#546E7A" VerticalAlignment="Center" Margin="8,0,12,0"/>
                <Border Background="#1E88E5" CornerRadius="3,3,0,0" Padding="14,7">
                    <TextBlock Name="CurrentFileTab" Text="No file loaded" Foreground="White" FontSize="12"/>
                </Border>
                <Button Name="CloseFileBtn" Content="✕" Width="22" Height="22" Padding="0"
                        Style="{StaticResource GreyBtn}" FontSize="10" Margin="4,0,0,0"
                        VerticalAlignment="Center" Click="CloseFileBtn_Click"/>
            </StackPanel>
        </Border>

        <!-- ═══════════ AI TRANSLATION PANEL ═══════════ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Background="#E8F5E9" Margin="8,8,8,4" BorderBrush="#C8E6C9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Name="AITranslationTitle" Text="🤖 AI Translation Center"
                          Style="{StaticResource SectionTitle}" Foreground="#2E7D32" Margin="0,0,0,10"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Translation Controls (simplified) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="TranslateSelectedBtn" Content="🎯 Translate Selected"
                                Click="TranslateSelectedBtn_Click" Style="{StaticResource PrimaryBtn}"/>

                        <!-- Batch Settings -->
                        <Border Background="White" CornerRadius="6" Padding="10,6" Margin="8,0" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="BatchLabelText" Text="Batch:" Foreground="#78909C" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Name="BatchSizeTxt" Text="50" Width="42" FontSize="13"
                                        BorderBrush="#CFD8DC" BorderThickness="1" Padding="4,3"
                                        VerticalAlignment="Center" TextChanged="BatchSizeTxt_TextChanged" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button Name="TranslateAllBtn" Content="🚀 Translate All"
                                Click="TranslateAllBtn_Click" Style="{StaticResource WarningBtn}"/>

                        <Button Name="PauseBtn" Content="⏸ Pause"
                                Click="PauseBtn_Click" Style="{StaticResource GreyBtn}"
                                Visibility="Collapsed" Margin="8,0,3,0"/>
                        <Button Name="StopBtn" Content="⏹ Stop"
                                Click="StopBtn_Click" Style="{StaticResource DangerBtn}"
                                Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Right: Info Pills only (no clear buttons) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Style="{StaticResource TagPill}" Background="#E8F5E9">
                            <TextBlock Name="EvalResult" Text=""
                                      Style="{StaticResource InfoLabel}" Foreground="#2E7D32"
                                      ToolTip="Last evaluation result"/>
                        </Border>
                        <Border Style="{StaticResource TagPill}" Background="#E3F2FD">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="CacheInfo" Text="💾 Cache: 0"
                                          Style="{StaticResource InfoLabel}" Foreground="#1565C0"/>
                                <Button Name="ClearCacheBtn" Content="🗑 清空缓存"
                                        Click="ClearCacheBtn_Click" Style="{StaticResource GreyBtn}"
                                        FontSize="11" Padding="8,4" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TagPill}" Background="#F3E5F5">
                            <TextBlock Name="GlossaryInfo" Text="📖 Glossary: 0"
                                      Style="{StaticResource InfoLabel}" Foreground="#7B1FA2"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════ MAIN CONTENT ═══════════ -->
        <Grid Grid.Row="4" Margin="8,4,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT: DataGrid ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="TranslationDataTitle" Text="📋 Translation Data"
                                  Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBlock Grid.Column="1" Name="FilterCountText" Text="0"
                                  Foreground="#90A4AE" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Filter Row -->
                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Name="ClearFilterBtn" Content="✕"
                                    Click="ClearFilterBtn_Click" Style="{StaticResource GreyBtn}"
                                    Padding="4,0" FontSize="14" Margin="2,0" ToolTip="Clear Filters"/>
                            <CheckBox Name="UntranslatedToggle" Content="Untranslated"
                                      VerticalAlignment="Center" Margin="6,0,0,0"
                                      Click="UntranslatedToggle_Click" FontSize="12"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Name="FilterKeyBox" Margin="2" Padding="7,5" FontSize="13"
                                BorderBrush="#CFD8DC" BorderThickness="1"
                                TextChanged="FilterKeyBox_TextChanged" ToolTip="Filter by Key"/>
                        <TextBox Grid.Column="2" Name="FilterBox" Margin="2" Padding="7,5" FontSize="13"
                                BorderBrush="#CFD8DC" BorderThickness="1"
                                TextChanged="FilterBox_TextChanged" ToolTip="Filter by Original"/>
                        <TextBox Grid.Column="3" Name="FilterTranslationBox" Margin="2" Padding="7,5" FontSize="13"
                                BorderBrush="#CFD8DC" BorderThickness="1"
                                TextChanged="FilterTranslationBox_TextChanged" ToolTip="Filter by Translation"/>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2" Name="EntriesGrid"
                             AutoGenerateColumns="False" CanUserAddRows="False"
                             SelectionMode="Extended" GridLinesVisibility="Horizontal"
                             AlternatingRowBackground="#F8FAFB" HeadersVisibility="Column"
                             BorderThickness="0" Loaded="EntriesGrid_Loaded"
                             FontSize="12.5">
                        <DataGrid.ContextMenu>
                            <ContextMenu FontSize="12">
                                <MenuItem Name="CtxCopyKeyMenu" Header="📋 Copy Key" Click="CtxCopyKey_Click"/>
                                <MenuItem Name="CtxCopyOriginalMenu" Header="📋 Copy Original" Click="CtxCopyOriginal_Click"/>
                                <MenuItem Name="CtxCopyTranslationMenu" Header="📋 Copy Translation" Click="CtxCopyTranslation_Click"/>
                                <Separator/>
                                <MenuItem Name="CtxClearTranslationMenu" Header="🗑 Clear Translation" Click="CtxClearTranslation_Click"/>
                                <MenuItem Name="CtxTranslateSelectedMenu" Header="🌐 Translate Selected" Click="CtxTranslateSelected_Click"/>
                                <Separator/>
                                <MenuItem Name="CtxEvaluateMenu" Header="🤖 AI Evaluate" Click="CtxEvaluate_Click"/>
                                <MenuItem Name="CtxVoteMenu" Header="🗳 Agent Vote" Click="CtxVote_Click"/>
                                <Separator/>
                                <MenuItem Name="CtxMarkReviewedMenu" Header="✅ Mark Reviewed" Click="CtxMarkReviewed_Click"/>
                                <MenuItem Name="CtxMarkNeedsFixMenu" Header="🔧 Mark Needs Fix" Click="CtxMarkNeedsFix_Click"/>
                                <MenuItem Name="CtxMarkUnreviewedMenu" Header="📝 Mark Unreviewed" Click="CtxMarkUnreviewed_Click"/>
                                <Separator/>
                                <MenuItem Name="CtxSelectAllMenu" Header="☑ Select All" Click="CtxSelectAll_Click"/>
                                <MenuItem Name="CtxSelectNoneMenu" Header="☐ Deselect All" Click="CtxSelectNone_Click"/>
                                <MenuItem Name="CtxInvertSelectionMenu" Header="🔄 Invert" Click="CtxInvertSelection_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#ECEFF1"/>
                                <Setter Property="Foreground" Value="#455A64"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="#CFD8DC"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="36" IsReadOnly="True" FontFamily="Consolas" FontSize="11"/>
                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected}" Width="36"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusIcon}" Width="48" IsReadOnly="True" FontSize="12"/>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*" IsReadOnly="True" MinWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Original" Binding="{Binding Value}" Width="1.5*" IsReadOnly="True" MinWidth="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Translation" Width="1.5*" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Translation}" TextWrapping="Wrap" VerticalAlignment="Center" Padding="8,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Translation, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap" AcceptsReturn="True"
                                                BorderThickness="0" Padding="8,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ===== RIGHT: Activity Log ===== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Log Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="ActivityLogTitle" Text="📋 Activity Log"
                                  Style="{StaticResource SectionTitle}" Margin="0"/>
                        <Button Grid.Column="1" Name="ClearLogBtn" Content="🗑 Clear"
                               Click="ClearLogBtn_Click"
                               Style="{StaticResource GreyBtn}" Width="80" Padding="8,6" FontSize="11"/>
                    </Grid>

                    <!-- Console -->
                    <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="6" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Name="LogTextBox" TextWrapping="Wrap"
                                    FontFamily="Consolas, 'Cascadia Code', monospace"
                                    FontSize="11.5" IsReadOnly="True" Background="Transparent"
                                    Foreground="#00FF00" BorderThickness="0" Padding="12"
                                    AcceptsReturn="True" VerticalScrollBarVisibility="Disabled"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Log Stats -->
                    <Border Grid.Row="2" Background="#ECEFF1" CornerRadius="4" Padding="8,6" Margin="0,8,0,0">
                        <Grid>
                            <TextBlock Name="RealTimeLabel" Text="🕒 Real-time" FontSize="10"
                                      Foreground="#78909C" HorizontalAlignment="Left"/>
                            <TextBlock Name="AutoScrollLabel" Text="🔄 Auto-scroll" FontSize="10"
                                      Foreground="#78909C" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════ BOTTOM BAR ═══════════ -->
        <Border Grid.Row="5" Background="White" CornerRadius="4" Padding="10,6"
                Margin="8,0,8,8" BorderBrush="#E8ECF0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Name="StatusIndicator" Text="⚪" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Name="ProgressText" Text="" FontSize="11" Foreground="#546E7A" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Progress Bar -->
                <ProgressBar Grid.Column="1" Name="ProgressBar" Height="8"
                            IsIndeterminate="False" Visibility="Collapsed"
                            Foreground="#2196F3" Background="#ECEFF1" BorderThickness="0"
                            VerticalAlignment="Center" Margin="0,0,10,0"/>

                <!-- Speed / ETA / Cost -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Name="SpeedText" Text="" FontSize="10" Foreground="#90A4AE"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Name="EtaText" Text="" FontSize="10" Foreground="#90A4AE"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
