<Window x:Class="SimpleXmlEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:SimpleXmlEditor"
        Title="" Height="800" Width="1400"
        MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackgroundBrush}" FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif">

    <Window.Resources>
        <!-- Convert DataGrid column DisplayIndex to an Excel-style letter (A, B, C, ...) -->
        <local:IndexToLetterConverter x:Key="IndexToLetter"/>
        <local:CellHighlightConverter x:Key="CellHighlight"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ MENU BAR (HandyControl style) ═══════════ -->
        <Menu Grid.Row="0" FontSize="14" FontWeight="SemiBold">

            <!-- File -->
            <MenuItem Name="MenuFile" Header="📁 File">
                <MenuItem Name="MenuOpen" Header="📂 Open (Ctrl+O)" Click="LoadBtn_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Name="MenuSave" Header="💾 Save (Ctrl+S)" Click="SaveBtn_Click" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Name="MenuExportReview" Header="📋 Export Review (CSV)" Click="ExportReviewBtn_Click"/>
                <Separator/>
                <MenuItem Name="MenuSettings" Header="⚙️ Settings" Click="SettingsBtn_Click"/>
                <Separator/>
                <MenuItem Name="MenuExit" Header="Exit" Click="MenuExit_Click"/>
            </MenuItem>

            <!-- Edit -->
            <MenuItem Name="MenuEdit" Header="✏️ Edit">
                <MenuItem Name="MenuUndo" Header="↩️ Undo" Click="UndoBtn_Click"/>
                <MenuItem Name="MenuReplace" Header="🔄 Replace" Click="BatchReplaceBtn_Click"/>
            </MenuItem>

            <!-- View -->
            <MenuItem Name="MenuView" Header="👁 View">
                <MenuItem Name="MenuDarkMode" Header="🌙 Dark Mode" Click="MenuDarkMode_Click"/>
                <MenuItem Name="MenuShowFilter" Header="🔍 Show Filter" Click="MenuShowFilter_Click"/>
                <MenuItem Name="MenuShowLog" Header="📋 Show Log" Click="MenuShowLog_Click"/>
            </MenuItem>

            <!-- Translate -->
            <MenuItem Name="MenuTranslate" Header="🌐 Translate">
                <MenuItem Name="MenuTranslateSelected" Header="🎯 Selected" Click="TranslateSelectedBtn_Click"/>
                <MenuItem Name="MenuTranslateAll" Header="🚀 All" Click="TranslateAllBtn_Click"/>
                <MenuItem Name="MenuSmartPreTrans" Header="🔮 Smart Pre-trans" Click="MenuSmartPreTrans_Click"/>
            </MenuItem>

            <!-- Quality -->
            <MenuItem Name="MenuQuality" Header="⭐ Quality">
                <MenuItem Name="MenuEvaluate" Header="🤖 AI Evaluate (F5)" Click="EvaluateBtn_Click" InputGestureText="F5"/>
                <MenuItem Name="MenuVote" Header="🗳 Agent Vote (F6)" Click="VoteBtn_Click" InputGestureText="F6"/>
                <MenuItem Name="MenuConsistency" Header="🔍 Consistency" Click="MenuConsistency_Click"/>
            </MenuItem>

            <!-- Tools -->
            <MenuItem Name="MenuTools" Header="🔧 Tools">
                <MenuItem Name="MenuGlossary" Header="📖 Glossary" Click="GlossaryBtn_Click"/>
                <MenuItem Name="MenuBlacklist" Header="🚫 Blacklist" Click="BlacklistBtn_Click"/>
                <MenuItem Name="MenuStatistics" Header="📊 Statistics" Click="StatsBtn_Click"/>
                <Separator/>
                <MenuItem Name="MenuClearDict" Header="🗑️ Clear Glossary" Click="ClearDictBtn_Click"/>
            </MenuItem>

            <!-- Help -->
            <MenuItem Name="MenuHelp" Header="❓ Help">
                <MenuItem Name="MenuShortcuts" Header="⌨ Shortcuts" Click="MenuShortcuts_Click"/>
                <MenuItem Name="MenuAbout" Header="ℹ️ About" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- ═══════════ SIMPLIFIED HEADER TOOLBAR ═══════════ -->
        <Border Grid.Row="1" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="17" VerticalAlignment="Center" Margin="0,0,12,0" ClipToBounds="True" BorderBrush="{DynamicResource AppTitleForegroundBrush}" BorderThickness="1">
                        <Image Source="pack://application:,,,/Assets/logo.jpg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Name="AppNameText" Text="次元译桥" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTitleForegroundBrush}"/>
                        <TextBlock Name="StatusText" Text="Ready" FontSize="11" Foreground="{DynamicResource AppSubForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Primary Action Buttons (simplified) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="LoadBtn" Content="📁 Load XML" Click="LoadBtn_Click" Style="{StaticResource PrimaryBtn}"/>
                    <Button Name="SaveBtn" Content="💾 Save" Click="SaveBtn_Click" Style="{StaticResource SuccessBtn}"/>

                    <Separator Style="{x:Null}" Width="10"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <hc:ComboBox Name="ExpertProfileCombo" Height="30" Width="150"
                                     SelectionChanged="ExpertProfileCombo_SelectionChanged"
                                     Margin="4,0" FontSize="12">
                            <ComboBoxItem Name="NoExpertItem" Content="No Expert" Tag="" IsSelected="True"/>
                        </hc:ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ FILE TABS PANEL ═══════════ -->
        <Border Grid.Row="2" Name="FileTabsPanel" Background="{DynamicResource TabHeaderBackgroundBrush}" Padding="8,4"
                BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,0,0,1" Visibility="Visible">
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="ProjectFiles" Text="📄 Project" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppSubForegroundBrush}" VerticalAlignment="Center" Margin="8,0,12,0"/>
                <Border Background="#1E88E5" CornerRadius="3,3,0,0" Padding="14,7">
                    <TextBlock Name="CurrentFileTab" Text="No file loaded" Foreground="White" FontSize="12"/>
                </Border>
                <Button Name="CloseFileBtn" Content="✕" Width="22" Height="22" Padding="0"
                        Style="{StaticResource GreyBtn}" FontSize="10" Margin="4,0,0,0"
                        VerticalAlignment="Center" Click="CloseFileBtn_Click"
                        ToolTip="Close current file (Ctrl+W)"/>
            </StackPanel>
        </Border>

        <!-- ═══════════ AI TRANSLATION PANEL ═══════════ -->
        <Border Grid.Row="3" Background="{DynamicResource SuccessChipBgBrush}" Margin="8,8,8,4" BorderBrush="{DynamicResource SuccessChipFgBrush}"
                CornerRadius="8" Padding="16" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Name="AITranslationTitle" Text="🤖 AI Translation Center"
                          FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SuccessChipFgBrush}" Margin="0,0,0,10"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Translation Controls (simplified) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="TranslateSelectedBtn" Content="🎯 Translate Selected"
                                Click="TranslateSelectedBtn_Click" Style="{StaticResource PrimaryBtn}"/>

                        <!-- Batch Settings -->
                        <Border Background="{DynamicResource BatchPanelBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="8,0" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="BatchLabelText" Text="Batch:" Foreground="{DynamicResource AppSubForegroundBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <hc:TextBox Name="BatchSizeTxt" Text="50" Width="42" FontSize="13"
                                            VerticalAlignment="Center" TextChanged="BatchSizeTxt_TextChanged" TextAlignment="Center"/>
                                <TextBlock Name="ConcurrentLabelText" Text=" 并发:" Foreground="{DynamicResource AppSubForegroundBrush}" FontSize="12" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                <hc:TextBox Name="ConcurrentBatchesTxt" Text="3" Width="36" FontSize="13"
                                            VerticalAlignment="Center" TextChanged="ConcurrentBatchesTxt_TextChanged" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button Name="TranslateAllBtn" Content="🚀 Translate All"
                                Click="TranslateAllBtn_Click" Style="{StaticResource WarningBtn}"/>

                        <Button Name="PauseBtn" Content="⏸ Pause"
                                Click="PauseBtn_Click" Style="{StaticResource GreyBtn}"
                                Visibility="Collapsed" Margin="8,0,3,0"/>
                        <Button Name="StopBtn" Content="⏹ Stop"
                                Click="StopBtn_Click" Style="{StaticResource DangerBtn}"
                                Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Right: Info Pills only (no clear buttons) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border CornerRadius="12" Padding="12,5" Margin="4,0" Background="{DynamicResource SuccessChipBgBrush}">
                            <TextBlock Name="EvalResult" Text=""
                                      FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                      Foreground="{DynamicResource SuccessChipFgBrush}"
                                      ToolTip="Last evaluation result"/>
                        </Border>
                        <Border CornerRadius="12" Padding="12,5" Margin="4,0" Background="{DynamicResource InfoChipBgBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="CacheInfo" Text="💾 Cache: 0"
                                          FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                          Foreground="{DynamicResource InfoChipFgBrush}"/>
                                <Button Name="ClearCacheBtn" Content="🗑 清空缓存"
                                        Click="ClearCacheBtn_Click" Style="{StaticResource GreyBtn}"
                                        FontSize="11" Padding="8,4" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="12" Padding="12,5" Margin="4,0" Background="{DynamicResource AccentChipBgBrush}">
                            <TextBlock Name="GlossaryInfo" Text="📖 Glossary: 0"
                                      FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                      Foreground="{DynamicResource AccentChipFgBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════ MAIN CONTENT ═══════════ -->
        <Grid Grid.Row="4" Margin="8,4,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="LogColumn" Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT: DataGrid ===== -->
            <Border Grid.Column="0" Background="{DynamicResource BatchPanelBackgroundBrush}" Margin="0,0,4,0" BorderBrush="{DynamicResource HeaderBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Name="TranslationDataTitle" Text="📋 Translation Data"
                                  FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTitleForegroundBrush}" Margin="0"/>
                        <TextBlock Grid.Column="1" Name="FilterCountText" Text="0"
                                  Foreground="{DynamicResource AppSubForegroundBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Filter Row -->
                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Name="ClearFilterBtn" Content="✕"
                                    Click="ClearFilterBtn_Click" Style="{StaticResource GreyBtn}"
                                    Padding="4,0" FontSize="14" Margin="2,0" ToolTip="Clear Filters"/>
                            <CheckBox Name="UntranslatedToggle" Content="Untranslated"
                                      VerticalAlignment="Center" Margin="6,0,0,0"
                                      Click="UntranslatedToggle_Click" FontSize="12"/>
                            <CheckBox Name="HideBlacklistToggle" Content="Hide Blacklist" IsChecked="True"
                                      VerticalAlignment="Center" Margin="10,0,0,0"
                                      Click="HideBlacklistToggle_Click" FontSize="12"/>
                        </StackPanel>
                        <hc:TextBox Grid.Column="1" Name="FilterKeyBox" Margin="2" Padding="7,5" FontSize="13"
                                    hc:InfoElement.Placeholder="筛选 Key…" hc:InfoElement.ShowClearButton="True"
                                    TextChanged="FilterKeyBox_TextChanged" ToolTip="Filter by Key"/>
                        <hc:TextBox Grid.Column="2" Name="FilterBox" Margin="2" Padding="7,5" FontSize="13"
                                    hc:InfoElement.Placeholder="筛选原文…" hc:InfoElement.ShowClearButton="True"
                                    TextChanged="FilterBox_TextChanged" ToolTip="Filter by Original"/>
                        <hc:TextBox Grid.Column="3" Name="FilterTranslationBox" Margin="2" Padding="7,5" FontSize="13"
                                    hc:InfoElement.Placeholder="筛选译文…" hc:InfoElement.ShowClearButton="True"
                                    TextChanged="FilterTranslationBox_TextChanged" ToolTip="Filter by Translation"/>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2" Name="EntriesGrid"
                             AutoGenerateColumns="False" CanUserAddRows="False"
                             SelectionMode="Extended" SelectionUnit="CellOrRowHeader"
                             HeadersVisibility="All"
                             RowHeaderWidth="70"
                             GridLinesVisibility="All"
                             Background="{DynamicResource RegionBrush}"
                             RowBackground="{DynamicResource RegionBrush}"
                             AlternatingRowBackground="{DynamicResource SecondaryRegionBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             HorizontalGridLinesBrush="{DynamicResource ThirdlyBorderBrush}" VerticalGridLinesBrush="{DynamicResource ThirdlyBorderBrush}"
                             BorderThickness="0"
                             Loaded="EntriesGrid_Loaded"
                             BeginningEdit="EntriesGrid_BeginningEdit"
                             CellEditEnding="EntriesGrid_CellEditEnding"
                             PreviewKeyDown="EntriesGrid_PreviewKeyDown"
                             PreviewMouseLeftButtonDown="EntriesGrid_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="EntriesGrid_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="EntriesGrid_PreviewMouseLeftButtonUp"
                             EnableRowVirtualization="True"
                             EnableColumnVirtualization="True"
                             FontSize="12.5">
                        <DataGrid.ContextMenu>
                            <ContextMenu FontSize="12">
                                <MenuItem Name="CtxCopyKeyMenu" Header="📋 Copy Key" Click="CtxCopyKey_Click"/>
                                <MenuItem Name="CtxCopyOriginalMenu" Header="📋 Copy Original" Click="CtxCopyOriginal_Click"/>
                                <MenuItem Name="CtxCopyTranslationMenu" Header="📋 Copy Translation" Click="CtxCopyTranslation_Click"/>
                                <Separator/>
                                <MenuItem Name="CtxClearTranslationMenu" Header="🗑 Clear Translation" Click="CtxClearTranslation_Click"/>
                                <MenuItem Name="CtxTranslateSelectedMenu" Header="🌐 Translate Selected" Click="CtxTranslateSelected_Click"/>
                                <Separator/>
                                <MenuItem Name="CtxEvaluateMenu" Header="🤖 AI Evaluate" Click="CtxEvaluate_Click"/>
                                <MenuItem Name="CtxVoteMenu" Header="🗳 Agent Vote" Click="CtxVote_Click"/>
                                <Separator/>
                                <MenuItem Name="CtxMarkReviewedMenu" Header="✅ Mark Reviewed" Click="CtxMarkReviewed_Click"/>
                                <MenuItem Name="CtxMarkNeedsFixMenu" Header="🔧 Mark Needs Fix" Click="CtxMarkNeedsFix_Click"/>
                                <MenuItem Name="CtxMarkUnreviewedMenu" Header="📝 Mark Unreviewed" Click="CtxMarkUnreviewed_Click"/>
                                <Separator/>
                                <MenuItem Name="CtxSelectAllMenu" Header="☑ Select All" Click="CtxSelectAll_Click"/>
                                <MenuItem Name="CtxSelectNoneMenu" Header="☐ Deselect All" Click="CtxSelectNone_Click"/>
                                <MenuItem Name="CtxInvertSelectionMenu" Header="🔄 Invert" Click="CtxInvertSelection_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource ColHeaderBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ColHeaderForegroundBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ColHeaderBorderBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Grid Background="{TemplateBinding Background}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="18"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <!-- Column letter strip: same size as the cell below (Excel-style),
                                                     letter centered inside; click anywhere in this row = select the whole column -->
                                                <Button x:Name="ColLetterBtn" Grid.Row="0" Padding="0" Cursor="Hand"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        Foreground="{DynamicResource ColHeaderLetterForegroundBrush}" FontWeight="Bold" FontSize="10"
                                                        Background="{DynamicResource ColHeaderLetterBackgroundBrush}" BorderBrush="{DynamicResource ColHeaderLetterBorderBrush}" BorderThickness="0,0,0,1"
                                                        Content="{Binding Column.DisplayIndex, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IndexToLetter}}"
                                                        Click="ColumnLetterBtn_Click"
                                                        Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ColHeaderLetterHoverBackgroundBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <!-- Sortable column title -->
                                                <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                            Margin="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                    <TextBlock x:Name="SortArrow" Text="▲" FontSize="9"
                                                               Foreground="{DynamicResource ColHeaderSortArrowBrush}" Margin="4,0,0,0" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="SortDirection" Value="Ascending">
                                                    <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="SortArrow" Property="Text" Value="▲"/>
                                                </Trigger>
                                                <Trigger Property="SortDirection" Value="Descending">
                                                    <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="SortArrow" Property="Text" Value="▼"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowHeaderStyle>
                            <Style TargetType="DataGridRowHeader">
                                <Setter Property="Background" Value="{DynamicResource RowHeaderBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource RowHeaderForegroundBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ColHeaderBorderBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridRowHeader">
                                            <Grid>
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <TextBlock Text="{Binding RowNumber}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                                <!-- Excel-style row-height drag handle -->
                                                <Thumb x:Name="RowResizeThumb"
                                                       DragDelta="RowResizeThumb_DragDelta"
                                                       DragStarted="RowResizeThumb_DragStarted"
                                                       DragCompleted="RowResizeThumb_DragCompleted"
                                                       VerticalAlignment="Bottom"
                                                       Height="5"
                                                       Cursor="SizeNS">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Height="{TemplateBinding Height}"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsEditing" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DefaultBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    </Trigger>
                                    <!-- 逻辑选择（全选/整列/Shift 范围）高亮：cell 级数据驱动，虚拟化滚动容器重建自动恢复。
                                         整列模式（LogicalSelectColumnIndex>=0）仅高亮该列，与 Ctrl+A 全选区分 -->
                                    <DataTrigger>
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource CellHighlight}">
                                                <Binding Path="IsHighlighted"/>
                                                <Binding RelativeSource="{RelativeSource Self}" Path="Column.DisplayIndex"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType={x:Type Window}}" Path="LogicalSelectColumnIndex"/>
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <DataTrigger.Value>True</DataTrigger.Value>
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected}" Width="36"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusIcon}" Width="48" IsReadOnly="True" FontSize="12"/>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="240" MinWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Padding" Value="6,2"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="{DynamicResource DefaultBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Original" Binding="{Binding Value}" Width="360" MinWidth="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Padding" Value="6,2"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="{DynamicResource DefaultBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Translation" SortMemberPath="Translation" Width="*" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Translation}" TextWrapping="Wrap" VerticalAlignment="Center" Padding="8,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Translation, UpdateSourceTrigger=PropertyChanged}"
                                                TextWrapping="Wrap" AcceptsReturn="True"
                                                BorderThickness="0" Padding="8,4"
                                                Background="{DynamicResource DefaultBrush}"
                                                Foreground="{DynamicResource TextBrush}"
                                                CaretBrush="{DynamicResource TextBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Score" SortMemberPath="EvaluationScore" Width="70" MinWidth="50" CanUserResize="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding EvaluationScoreDisplay}"
                                                   Foreground="{Binding EvaluationScoreColor}"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Padding="4,4"
                                                   ToolTip="{Binding EvaluationImprovement}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ===== RIGHT: Activity Log ===== -->
            <Grid Grid.Column="1">
                <!-- Collapsed-state expand bar (always reachable) -->
                <Border x:Name="LogExpandBar" Background="{DynamicResource HeaderBackgroundBrush}" Margin="4,0,0,0"
                        BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="1" CornerRadius="8"
                        HorizontalAlignment="Left" Width="26" Visibility="Collapsed">
                    <Button Content="▶" Click="ToggleLogBtn_Click" Style="{StaticResource GreyBtn}"
                            Padding="0" FontSize="10" Margin="2,0,2,0"
                            ToolTip="Expand log"/>
                </Border>
                <Border x:Name="LogPanel" Background="{DynamicResource LogPanelBackgroundBrush}" Margin="4,0,0,0"
                        BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Log Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="ActivityLogTitle" Text="📋 Activity Log"
                                  FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTitleForegroundBrush}" Margin="0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Name="ToggleLogBtn" Content="◀" Click="ToggleLogBtn_Click"
                                    Style="{StaticResource GreyBtn}" Width="30" Padding="4,4" FontSize="10"
                                    Margin="0,0,4,0" ToolTip="Collapse log"/>
                            <Button Name="ClearLogBtn" Content="🗑 Clear"
                                   Click="ClearLogBtn_Click"
                                   Style="{StaticResource GreyBtn}" Width="80" Padding="8,6" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <!-- Console -->
                    <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="6" Padding="0">
                        <TextBox Name="LogTextBox" TextWrapping="Wrap"
                                FontFamily="Consolas, 'Cascadia Code', monospace"
                                FontSize="11.5" IsReadOnly="True" Background="Transparent"
                                Foreground="#00FF00" BorderThickness="0" Padding="12"
                                VerticalContentAlignment="Top"
                                AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </Border>

                    <!-- Log Stats -->
                    <Border Grid.Row="2" Background="{DynamicResource TabHeaderBackgroundBrush}" CornerRadius="4" Padding="8,6" Margin="0,8,0,0">
                        <Grid>
                            <TextBlock Name="RealTimeLabel" Text="🕒 Real-time" FontSize="10"
                                      Foreground="{DynamicResource AppSubForegroundBrush}" HorizontalAlignment="Left"/>
                            <TextBlock Name="AutoScrollLabel" Text="🔄 Auto-scroll" FontSize="10"
                                      Foreground="{DynamicResource AppSubForegroundBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <!-- ═══════════ BOTTOM BAR ═══════════ -->
        <Border Grid.Row="5" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="4" Padding="10,6"
                Margin="8,0,8,8" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#263238" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Name="StatusIndicator" Text="⚪" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Name="ProgressText" Text="" FontSize="11" Foreground="{DynamicResource AppSubForegroundBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Progress Bar -->
                <ProgressBar Grid.Column="1" Name="ProgressBar" Height="8"
                            IsIndeterminate="False" Visibility="Collapsed"
                            Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource HeaderBorderBrush}" BorderThickness="0"
                            VerticalAlignment="Center" Margin="0,0,10,0"/>

                <!-- Speed / ETA / Cost -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Name="SpeedText" Text="" FontSize="10" Foreground="{DynamicResource AppSubForegroundBrush}"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Name="EtaText" Text="" FontSize="10" Foreground="{DynamicResource AppSubForegroundBrush}"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Name="CostText" Text="" FontSize="10" FontWeight="SemiBold"
                              Foreground="#43A047" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
