<Window x:Class="SimpleXmlEditor.GlossaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:SimpleXmlEditor"
        Title="Glossary Manager" Height="700" Width="950"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        MinHeight="500" MinWidth="800"
        Background="{DynamicResource AppBackgroundBrush}" Loaded="Window_Loaded">

    <Window.Resources>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: Toolbar ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Action buttons + stats -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="AddBtn" Content="+ Add" Click="AddBtn_Click" Style="{StaticResource SuccessBtn}" FontSize="12" Padding="14,8"/>
                        <Button Name="EditBtn" Content="Edit" Click="EditBtn_Click" Style="{StaticResource PrimaryBtn}" FontSize="12"/>
                        <Button Name="DeleteBtn" Content="Delete" Click="DeleteBtn_Click" Style="{StaticResource DangerBtn}" FontSize="12"/>

                        <Separator Width="2" Background="{DynamicResource BorderBrush}" Margin="8,0"/>

                        <Button Name="ImportBtn" Content="Import" Click="ImportBtn_Click" Style="{StaticResource PrimaryBtn}" FontSize="12"/>
                        <Button Name="ExportBtn" Content="Export" Click="ExportBtn_Click" Style="{StaticResource PrimaryBtn}" FontSize="12"/>
                        <Button Name="ShareBtn" Content="Share" Click="ShareBtn_Click" Style="{StaticResource SuccessBtn}" FontSize="12" ToolTip="Export glossary for community sharing with game metadata"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Name="StatsTxt" Text="0 terms" Foreground="{DynamicResource HeaderForegroundBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Name="RefreshBtn" Content="Refresh" Click="RefreshBtn_Click" Style="{StaticResource CyanBtn}" FontSize="12"/>
                        <Button Name="CloseBtn" Content="Close" Click="CloseBtn_Click" Style="{StaticResource PrimaryBtn}" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Search + merge/conflict actions -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <hc:TextBox Name="SearchTxt" Width="220" Height="28" FontSize="13" Margin="0,0,8,0"
                                    hc:InfoElement.Placeholder="搜索术语…" hc:InfoElement.ShowClearButton="True"
                                    TextChanged="SearchTxt_TextChanged"/>

                        <hc:ComboBox Name="CategoryFilter" Height="28" Width="130" FontSize="12" Margin="0,0,8,0"
                                  SelectionChanged="Filter_Changed" ToolTip="Filter by category"/>
                        <hc:ComboBox Name="StatusFilter" Height="28" Width="130" FontSize="12"
                                  SelectionChanged="Filter_Changed" ToolTip="Filter by status"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="MergeProfileBtn" Content="Merge Profile" Click="MergeProfileBtn_Click" Style="{StaticResource WarningBtn}" FontSize="12"/>
                        <Button Name="DetectConflictsBtn" Content="Detect Conflicts" Click="DetectConflictsBtn_Click" Style="{StaticResource DangerBtn}" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ Row 1: DataGrid ═══ -->
        <DataGrid Grid.Row="1" Name="TermsGrid" Style="{StaticResource DataGridStyle}" Margin="0"
                  AutoGenerateColumns="False"
                  MouseDoubleClick="TermsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="English (Source)" Binding="{Binding English}" Width="2*" MinWidth="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Chinese (Target)" Binding="{Binding Chinese}" Width="2*" MinWidth="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" MinWidth="80"/>
                <DataGridTemplateColumn Header="Status" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}" 
                                       HorizontalAlignment="Center" 
                                       FontWeight="Bold" FontSize="11"
                                       Foreground="{Binding Status, Converter={x:Static local:StatusColorConverter.Instance}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="Auto" MinWidth="50" MaxWidth="240"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══ Row 2: Bottom bar ═══ -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="BottomStatsTxt" Text="0 confirmed, 0 pending, 0 rejected" 
                          Foreground="{DynamicResource HeaderForegroundBrush}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Name="BottomCategoryTxt" Text="" Foreground="{DynamicResource HeaderForegroundBrush}" FontSize="11" 
                          VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
