<Window x:Class="SimpleXmlEditor.EvaluationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evaluation Window" Height="500" Width="750"
        Background="#F0EEF6" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="ScoreCell" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EvalListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#F7F6FB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <DataTemplate x:Key="EvalItemTemplate">
            <Border BorderBrush="#E8ECF0" BorderThickness="0,0,0,1" Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Score -->
                    <Border Grid.Column="0" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Score}" Value="0">
                                        <Setter Property="Background" Value="#E0E0E0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ScoreDisplay}" Style="{StaticResource ScoreCell}"
                                   Foreground="{Binding ScoreColor}"/>
                    </Border>

                    <!-- Details -->
                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                        <TextBlock Text="{Binding EntryKey}" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="#37474F" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Explanation}" FontSize="10" Foreground="#78909C"
                                   TextTrimming="CharacterEllipsis" MaxHeight="32"/>
                    </StackPanel>

                    <!-- Apply Suggestion -->
                    <Button Grid.Column="2" Content="Apply" FontSize="10"
                            Padding="8,4" Click="ApplySuggestion_Click"
                            Tag="{Binding}"
                            Style="{StaticResource SuccessBtn}"
                            Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVis}}">
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="WindowTitle" Text="Evaluation" FontSize="16" FontWeight="Bold" Foreground="#1E88E5"/>
            <TextBlock Name="SummaryText" FontSize="11" Foreground="#78909C" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Score Distribution -->
        <Border Grid.Row="1" Background="#EAE8F4" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ScoreDistLabel" Text="Score Distribution:" FontSize="11" Foreground="#546E7A" VerticalAlignment="Center"/>
                <Border Background="#E8F5E9" CornerRadius="3" Padding="6,2" Margin="4,0">
                    <TextBlock Name="HighCount" Text="-" FontSize="10" Foreground="#2E7D32"/>
                </Border>
                <Border Background="#FFF8E1" CornerRadius="3" Padding="6,2" Margin="4,0">
                    <TextBlock Name="MidCount" Text="-" FontSize="10" Foreground="#F57F17"/>
                </Border>
                <Border Background="#FFEBEE" CornerRadius="3" Padding="6,2" Margin="4,0">
                    <TextBlock Name="LowCount" Text="-" FontSize="10" Foreground="#C62828"/>
                </Border>
                <Border Background="#E3F2FD" CornerRadius="3" Padding="6,2" Margin="4,0">
                    <TextBlock Name="AvgScoreText" Text="--" FontSize="10" Foreground="#1565C0" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Results List -->
        <ListBox Grid.Row="2" Name="ResultsList" ItemTemplate="{StaticResource EvalItemTemplate}"
                 Style="{StaticResource EvalListBox}"/>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="MarkLowScoresBtn" Content="Mark Low" Click="MarkLowScores_Click" FontSize="11"
                    Padding="12,6" Margin="0,0,8,0" Style="{StaticResource GreyBtn}"/>
            <Button x:Name="CloseBtn" Content="Close" Click="Close_Click" FontSize="11" Padding="16,6"
                    Style="{StaticResource GreyBtn}"/>
        </StackPanel>
    </Grid>
</Window>
