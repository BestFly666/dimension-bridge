<Window x:Class="SimpleXmlEditor.BlacklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Blacklist Manager" Height="600" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        MinHeight="450" MinWidth="520"
        Background="{DynamicResource AppBackgroundBrush}" Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: Key prefix toolbar ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Key prefix" Foreground="{DynamicResource HeaderForegroundBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <hc:TextBox Grid.Column="1" Name="PrefixTxt" Width="180" Height="28" FontSize="13" Margin="0,0,8,0"
                            hc:InfoElement.Placeholder="TEXT_SPEECH_"
                            KeyDown="PrefixTxt_KeyDown"/>
                <Button Grid.Column="2" Name="AddBtn" Content="+ Add" Click="AddBtn_Click" Style="{StaticResource SuccessBtn}" FontSize="12" Padding="14,8" HorizontalAlignment="Left"/>
                <Button Grid.Column="3" Name="DeleteBtn" Content="Delete" Click="DeleteBtn_Click" Style="{StaticResource DangerBtn}" FontSize="12" Margin="8,0,0,0"/>
                <TextBlock Grid.Column="4" Name="StatsTxt" Text="0 rules" Foreground="{DynamicResource HeaderForegroundBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,8,0"/>
                <Button Grid.Column="5" Name="CloseBtn" Content="Close" Click="CloseBtn_Click" Style="{StaticResource PrimaryBtn}" FontSize="12"/>
            </Grid>
        </Border>

        <!-- ═══ Row 1: Key prefix grid ═══ -->
        <DataGrid Grid.Row="1" Name="PrefixGrid" Style="{StaticResource DataGridStyle}" Margin="0"
                  AutoGenerateColumns="False"
                  SelectionChanged="PrefixGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Key Prefix" Binding="{Binding Prefix}" Width="*" MinWidth="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══ Row 2: Exact original text toolbar ═══ -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,1,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Original exact" Foreground="{DynamicResource HeaderForegroundBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <hc:TextBox Grid.Column="1" Name="ExactTxt" Width="220" Height="28" FontSize="13" Margin="0,0,8,0"
                            hc:InfoElement.Placeholder="UNUSED"
                            KeyDown="ExactTxt_KeyDown"/>
                <Button Grid.Column="2" Name="ExactAddBtn" Content="+ Add" Click="ExactAddBtn_Click" Style="{StaticResource SuccessBtn}" FontSize="12" Padding="14,8" HorizontalAlignment="Left"/>
                <Button Grid.Column="3" Name="ExactDeleteBtn" Content="Delete" Click="ExactDeleteBtn_Click" Style="{StaticResource DangerBtn}" FontSize="12" Margin="8,0,0,0"/>
                <TextBlock Grid.Column="4" Name="ExactStatsTxt" Text="0 rules" Foreground="{DynamicResource HeaderForegroundBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- ═══ Row 3: Exact original text grid ═══ -->
        <DataGrid Grid.Row="3" Name="ExactGrid" Style="{StaticResource DataGridStyle}" Margin="0"
                  AutoGenerateColumns="False"
                  SelectionChanged="ExactGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Original Text (exact match)" Binding="{Binding OriginalText}" Width="*" MinWidth="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══ Row 4: Bottom bar ═══ -->
        <Border Grid.Row="4" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock Name="HintTxt" Text="Entries whose Key starts with a prefix OR whose original text matches exactly are skipped during translation."
                       Foreground="{DynamicResource HeaderForegroundBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
