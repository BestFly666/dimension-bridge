<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════
         App accent palette — DARK (Catppuccin Mocha inspired)
         Generic chrome (text/borders/selection/regions) uses the
         HandyControl semantic brushes (TextBrush, RegionBrush,
         BorderBrush, PrimaryBrush, ...) which adapt to the active
         HandyControl skin. This dictionary only carries the app's
         own personality colors.
         ══════════════════════════════════════════════════════════ -->

    <!-- Window / surface -->
    <Color x:Key="AppBackgroundColor">#1E1E2E</Color>
    <Color x:Key="BatchPanelBackgroundColor">#252537</Color>
    <Color x:Key="LogPanelBackgroundColor">#252537</Color>

    <!-- Header / toolbar / tab strip -->
    <Color x:Key="HeaderBackgroundColor">#252537</Color>
    <Color x:Key="HeaderForegroundColor">#A6ADC8</Color>
    <Color x:Key="HeaderBorderColor">#45475A</Color>
    <Color x:Key="TabHeaderBackgroundColor">#252537</Color>

    <!-- Column header chrome (Excel-style letter strip) -->
    <Color x:Key="ColHeaderBackgroundColor">#252537</Color>
    <Color x:Key="ColHeaderForegroundColor">#A6ADC8</Color>
    <Color x:Key="ColHeaderBorderColor">#45475A</Color>
    <Color x:Key="ColHeaderLetterBackgroundColor">#313244</Color>
    <Color x:Key="ColHeaderLetterForegroundColor">#7F849C</Color>
    <Color x:Key="ColHeaderLetterBorderColor">#585B70</Color>
    <Color x:Key="ColHeaderLetterHoverBackgroundColor">#45475A</Color>
    <Color x:Key="ColHeaderSortArrowColor">#F5E0DC</Color>

    <!-- Row header -->
    <Color x:Key="RowHeaderBackgroundColor">#252537</Color>
    <Color x:Key="RowHeaderForegroundColor">#7F849C</Color>

    <!-- Text on app surfaces -->
    <Color x:Key="AppTitleForegroundColor">#CDD6F4</Color>
    <Color x:Key="AppSubForegroundColor">#A6ADC8</Color>

    <!-- Status chips -->
    <Color x:Key="SuccessChipBgColor">#1E3B2C</Color>
    <Color x:Key="SuccessChipFgColor">#81C784</Color>
    <Color x:Key="InfoChipBgColor">#1E3A5F</Color>
    <Color x:Key="InfoChipFgColor">#90CAF9</Color>
    <Color x:Key="AccentChipBgColor">#33284A</Color>
    <Color x:Key="AccentChipFgColor">#CE93D8</Color>

    <!-- ══════ Brushes ══════ -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="BatchPanelBackgroundBrush" Color="{StaticResource BatchPanelBackgroundColor}"/>
    <SolidColorBrush x:Key="LogPanelBackgroundBrush" Color="{StaticResource LogPanelBackgroundColor}"/>

    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource HeaderBackgroundColor}"/>
    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="{StaticResource HeaderForegroundColor}"/>
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="{StaticResource HeaderBorderColor}"/>
    <SolidColorBrush x:Key="TabHeaderBackgroundBrush" Color="{StaticResource TabHeaderBackgroundColor}"/>

    <SolidColorBrush x:Key="ColHeaderBackgroundBrush" Color="{StaticResource ColHeaderBackgroundColor}"/>
    <SolidColorBrush x:Key="ColHeaderForegroundBrush" Color="{StaticResource ColHeaderForegroundColor}"/>
    <SolidColorBrush x:Key="ColHeaderBorderBrush" Color="{StaticResource ColHeaderBorderColor}"/>
    <SolidColorBrush x:Key="ColHeaderLetterBackgroundBrush" Color="{StaticResource ColHeaderLetterBackgroundColor}"/>
    <SolidColorBrush x:Key="ColHeaderLetterForegroundBrush" Color="{StaticResource ColHeaderLetterForegroundColor}"/>
    <SolidColorBrush x:Key="ColHeaderLetterBorderBrush" Color="{StaticResource ColHeaderLetterBorderColor}"/>
    <SolidColorBrush x:Key="ColHeaderLetterHoverBackgroundBrush" Color="{StaticResource ColHeaderLetterHoverBackgroundColor}"/>
    <SolidColorBrush x:Key="ColHeaderSortArrowBrush" Color="{StaticResource ColHeaderSortArrowColor}"/>

    <SolidColorBrush x:Key="RowHeaderBackgroundBrush" Color="{StaticResource RowHeaderBackgroundColor}"/>
    <SolidColorBrush x:Key="RowHeaderForegroundBrush" Color="{StaticResource RowHeaderForegroundColor}"/>

    <SolidColorBrush x:Key="AppTitleForegroundBrush" Color="{StaticResource AppTitleForegroundColor}"/>
    <SolidColorBrush x:Key="AppSubForegroundBrush" Color="{StaticResource AppSubForegroundColor}"/>

    <SolidColorBrush x:Key="SuccessChipBgBrush" Color="{StaticResource SuccessChipBgColor}"/>
    <SolidColorBrush x:Key="SuccessChipFgBrush" Color="{StaticResource SuccessChipFgColor}"/>
    <SolidColorBrush x:Key="InfoChipBgBrush" Color="{StaticResource InfoChipBgColor}"/>
    <SolidColorBrush x:Key="InfoChipFgBrush" Color="{StaticResource InfoChipFgColor}"/>
    <SolidColorBrush x:Key="AccentChipBgBrush" Color="{StaticResource AccentChipBgColor}"/>
    <SolidColorBrush x:Key="AccentChipFgBrush" Color="{StaticResource AccentChipFgColor}"/>

</ResourceDictionary>
