<Window x:Class="SimpleXmlEditor.GlossaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimpleXmlEditor"
        Title="Glossary Manager" Height="700" Width="950"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        MinHeight="500" MinWidth="800"
        Background="#F5F5F5" Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#388E3C"/></Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#F44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#D32F2F"/></Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="WarningBtn" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#FF9800"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F57C00"/></Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F0F0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: Toolbar ═══ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Action buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="AddBtn" Content="+ Add" Click="AddBtn_Click" Style="{StaticResource SuccessBtn}" FontSize="12" Padding="14,8"/>
                    <Button Name="EditBtn" Content="Edit" Click="EditBtn_Click" Style="{StaticResource ModernButton}" FontSize="12"/>
                    <Button Name="DeleteBtn" Content="Delete" Click="DeleteBtn_Click" Style="{StaticResource DangerBtn}" FontSize="12"/>
                    
                    <Separator Width="2" Background="#E0E0E0" Margin="8,0"/>

                    <Button Name="ImportBtn" Content="Import" Click="ImportBtn_Click" Style="{StaticResource ModernButton}" FontSize="12"/>
                    <Button Name="ExportBtn" Content="Export" Click="ExportBtn_Click" Style="{StaticResource ModernButton}" FontSize="12"/>
                    <Button Name="ShareBtn" Content="Share" Click="ShareBtn_Click" Style="{StaticResource SuccessBtn}" FontSize="12" ToolTip="Export glossary for community sharing with game metadata"/>

                    <Separator Width="2" Background="#E0E0E0" Margin="8,0"/>

                    <Button Name="MergeProfileBtn" Content="Merge Profile" Click="MergeProfileBtn_Click" Style="{StaticResource WarningBtn}" FontSize="12"/>
                    <Button Name="DetectConflictsBtn" Content="Detect Conflicts" Click="DetectConflictsBtn_Click" Style="{StaticResource DangerBtn}" FontSize="12"/>
                </StackPanel>

                <!-- Center: Search box -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox Name="SearchTxt" Width="200" Height="28" FontSize="13" Margin="4,0"
                             TextChanged="SearchTxt_TextChanged"/>
                    
                    <ComboBox Name="CategoryFilter" Style="{StaticResource FilterCombo}"
                              SelectionChanged="Filter_Changed" ToolTip="Filter by category"/>
                    <ComboBox Name="StatusFilter" Style="{StaticResource FilterCombo}"
                              SelectionChanged="Filter_Changed" ToolTip="Filter by status"/>
                </StackPanel>

                <!-- Right: Stats -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Name="StatsTxt" Text="0 terms" Foreground="#666" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Name="RefreshBtn" Content="Refresh" Click="RefreshBtn_Click" Style="{StaticResource SmallBtn}"/>
                    <Button Name="CloseBtn" Content="Close" Click="CloseBtn_Click" Style="{StaticResource ModernButton}" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Row 1: DataGrid ═══ -->
        <DataGrid Grid.Row="1" Name="TermsGrid" Style="{StaticResource DataGridStyle}" Margin="0"
                  MouseDoubleClick="TermsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="English (Source)" Binding="{Binding English}" Width="2*" MinWidth="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Chinese (Target)" Binding="{Binding Chinese}" Width="2*" MinWidth="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" MinWidth="80"/>
                <DataGridTemplateColumn Header="Status" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}" 
                                       HorizontalAlignment="Center" 
                                       FontWeight="Bold" FontSize="11"
                                       Foreground="{Binding Status, Converter={x:Static local:StatusColorConverter.Instance}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="*" MinWidth="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══ Row 2: Bottom bar ═══ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="BottomStatsTxt" Text="0 confirmed, 0 pending, 0 rejected" 
                          Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Name="BottomCategoryTxt" Text="" Foreground="#888" FontSize="11" 
                          VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
